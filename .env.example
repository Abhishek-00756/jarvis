# Copy this file to .env and fill in what you use.

# Local model (must match something you've pulled with `ollama pull`)
JARVIS_MODEL=qwen2.5:7b
OLLAMA_HOST=http://localhost:11434

# Optional cloud fallback for hard reasoning tasks (Phase 5).
# Leave blank to stay 100% local.
ANTHROPIC_API_KEY=
JARVIS_CLOUD_FALLBACK_MODEL=claude-sonnet-5
JARVIS_CLOUD_AUTO_ESCALATE=false

# Optional real web search API (replaces the Phase 1 stub).
# e.g. Tavily: https://tavily.com
TAVILY_API_KEY=

# Voice wake word (Phase 2)
JARVIS_WAKE_WORD=hey_jarvis

# Long-term memory location
JARVIS_MEMORY_PATH=~/.jarvis_agent/memory
